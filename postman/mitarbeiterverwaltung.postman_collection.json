{
    "info": {
        "name": "Mitarbeiterverwaltung",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Create Employee",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 201\", function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "pm.test(\"Employee has ID\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.id).to.not.be.undefined;",
                            "    pm.globals.set(\"employeeId\", jsonData.id);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"firstName\": \"Max\",\n    \"lastName\": \"Mustermann\",\n    \"entryDate\": \"2023-10-01\",\n    \"skillLevel\": 3\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/api/employees",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "employees"
                    ]
                }
            },
            "response": []
        },
        {
