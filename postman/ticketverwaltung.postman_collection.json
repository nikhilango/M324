            "name": "Validation: Missing Employee ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 400\", function () {",
                            "    pm.response.to.have.status(400);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"title\": \"Sample Ticket\",\n    \"description\": \"Description\",\n    \"status\": \"OPEN\",\n    \"employeeId\": \"\"\n}",
                    "options": {
